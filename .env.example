# Neon pooled connection string (injected by the Vercel <-> Neon integration)
DATABASE_URL=
# openssl rand -base64 32
AUTH_SECRET=
# Resend API key (magic-link emails)
AUTH_RESEND_KEY=
# e.g. "Family App <login@yourdomain>"
AUTH_EMAIL_FROM=
# e.g. http://localhost:3000 locally, https://your-app.vercel.app in prod
NEXT_PUBLIC_APP_URL=
# Required by Auth.js when not auto-detected (Vercel sets it implicitly; harmless locally)
AUTH_TRUST_HOST=true
